# ==============================================================================
# SMART COLD-CHAIN TRACEABILITY — ENVIRONMENT TEMPLATE
# Copy this file to .env and configure local secrets.
# NEVER commit the real .env file into source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & BACKEND API (apps/api)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/coldchain_db?schema=public"

# Authentication & JWT
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret_in_production
JWT_EXPIRES_IN=24h

# Internal Services
AI_SERVICE_URL=http://localhost:8000
AI_API_KEY=
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# ------------------------------------------------------------------------------
# 2. AI ANOMALY DETECTION SERVICE (services/ai)
# ------------------------------------------------------------------------------
AI_PORT=8000
AI_HOST=0.0.0.0
AI_ENV=development
MODEL_ARTIFACT_DIR=./artifacts

# ------------------------------------------------------------------------------
# 3. SMART CONTRACTS & LOCAL BLOCKCHAIN (contracts)
# ------------------------------------------------------------------------------
HARDHAT_NETWORK=localhost
LOCAL_RPC_URL=http://127.0.0.1:8545
# Hardhat test account #0 default private key for local development only
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ------------------------------------------------------------------------------
# 4. FRONTEND WEB DASHBOARD (apps/web)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:4000/api/v1
VITE_APP_TITLE="Smart Cold-Chain Traceability System"

# ------------------------------------------------------------------------------
# 5. IOT SIMULATOR (services/simulator)
# ------------------------------------------------------------------------------
SIMULATOR_API_URL=http://localhost:4000/api/v1/sensors/telemetry
SIMULATOR_INTERVAL_MS=5000
